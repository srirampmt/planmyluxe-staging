# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
.claude
# production
/build
.plan
.vscode
CLAUDE.md
.env
.env.production

# misc
.DS_Store
*.pem
skills-lock.json
# brochure assets (avoid committing large PDFs)
/public/brouchers/*.pdf
/public/brouchers/*.PDF

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Previously only ".env*.local" was ignored here, which did NOT match
# ".env" or ".env.production" — both were tracked and pushed to GitHub with
# real secrets in them (PML-Search-Flow-Review.md C7). Ignoring them now
# stops future commits from re-adding secrets, but does NOT remove the
# already-pushed history — that needs `git rm --cached` for the current
# tip plus a history purge (git filter-repo/BFG) if the repo is public or
# has external collaborators, coordinated with anyone else with a clone.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.agents
agent
storage.rules
/umvifunctions
firestoreindex.json
firebase.json
# next-agents-md
.next-docs/
